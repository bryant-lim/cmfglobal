{
  "kind": "collectionType",
  "collectionName": "attendees",
  "info": {
    "singularName": "attendee",
    "pluralName": "attendees",
    "displayName": "Attendee",
    "description": "Information about individual event attendees."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "salutation": {
      "type": "string"
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "companyName": {
      "type": "string",
      "required": true
    },
    "eventName": {
      "type": "string"
    },
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order",
      "inversedBy": "attendees"
    },
    "referenceCode": {
      "type": "string",
      "unique": true
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "attendees",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
