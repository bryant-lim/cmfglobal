{
  "kind": "collectionType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Member Profile",
    "description": "Stores detailed member information and registration history"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "chineseName": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "companyName": {
      "type": "string",
      "required": true
    },
    "designation": {
      "type": "string",
      "required": true
    },
    "passportNo": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "pastYearIncome": {
      "type": "decimal"
    },
    "country": {
      "type": "string",
      "required": true
    },
    "billingName": {
      "type": "string"
    },
    "billingEmail": {
      "type": "email"
    },
    "billingPhone": {
      "type": "string"
    },
    "billingCompanyName": {
      "type": "string"
    },
    "billingCountry": {
      "type": "string"
    },
    "billingAddress": {
      "type": "text"
    },
    "portraitPhoto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "incomeSlip": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "wallet_records": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::membership-record.membership-record",
      "mappedBy": "profile"
    },
    "memberId": {
      "type": "string",
      "unique": true
    },
    "tShirtSize": {
      "type": "enumeration",
      "enum": [
        "S",
        "M",
        "L",
        "XL",
        "XXL"
      ]
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "Male",
        "Female"
      ]
    }
  }
}
